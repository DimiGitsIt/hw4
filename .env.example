# Signs session cookies (backend/auth.py). Auto-generated into .env on first
# run if missing — this file is just a placeholder so the format is documented.
SESSION_SECRET_KEY=replace-with-a-long-random-value

# Your Portkey API key, used to route chatbot requests through Portkey to OpenAI
# (backend/agent.py). Get one at https://portkey.ai — never commit a real key.
PORTKEY_API_KEY=your-key-here

# Optional — overrides the chatbot's default model (gpt-5.6-luna).
MODEL_NAME=gpt-5.6-luna
